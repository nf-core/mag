nextflow_pipeline {

    name "Test that an unreachable checkm_download_url doesn't block parameter validation when --run_checkm is off"
    script "../main.nf"
    tag "pipeline"
    tag "test_minimal"
    profile "test_minimal"

    // Regression test: checkm_download_url's schema entry used to declare
    // `"format": "file-path", "exists": true` on a non-null default (a Zenodo
    // URL), which nf-schema validates unconditionally at startup regardless
    // of whether --run_checkm is actually enabled (it isn't here, nor
    // anywhere in this profile). That meant every single pipeline run had a
    // silent, unconditional dependency on Zenodo being reachable. A bogus,
    // guaranteed-nonexistent value must not fail parameter validation.
    // -preview skips executing any process, but still runs the workflow
    // script itself -- including PIPELINE_INITIALISATION's parameter
    // validation, which is the only thing this test needs to exercise.
    test("-profile test_minimal, checkm_download_url unreachable") {

        options "-preview"

        when {
            params {
                outdir              = "$outputDir"
                checkm_download_url = "/definitely/does/not/exist.tar.gz"
            }
        }

        then {
            assert workflow.success
        }
    }
}
