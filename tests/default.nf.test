nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "test"

    test("-profile test") {

        when {
            params {
                outdir = "${outputDir}"
            }
        }

        then {
            // Output dir: QC_shortreads
            def stable_name_qc = getAllFilesFromDir(
                params.outdir, include: ['QC_shortreads/**'], relative: true, includeDir: false
            )
            def stable_path_qc = getAllFilesFromDir(
                params.outdir, include: ['QC_shortreads/**'], ignoreFile: 'tests/.nftignore'
            )
            def remove_phix_logs = getAllFilesFromDir(
                params.outdir, include: ['QC_shortreads/remove_phix/*.log']
            )

            // Output dir: Assembly
            def stable_name_assembly = getAllFilesFromDir(
                params.outdir, include: ['Assembly/**'], relative: true, includeDir: false
            )
            def stable_path_assembly = getAllFilesFromDir(
                params.outdir, include: ['Assembly/**'], ignoreFile: 'tests/.nftignore'
            )
            def megahit_logs = getAllFilesFromDir(
                params.outdir, include: ['Assembly/MEGAHIT/*.log']
            )
            def spades_logs = getAllFilesFromDir(
                params.outdir, include: ['Assembly/SPAdes/*.log']
            )
            def assembly_quast_logs = getAllFilesFromDir(
                params.outdir, include: ['Assembly/*/QC/*/QUAST/quast.log']
            )
            def bowtie2_assembly_logs = getAllFilesFromDir(
                params.outdir, include: ['Assembly/*/QC/*/*.log']
            )
            def megahit_contigs = getAllFilesFromDir(
                params.outdir, include: ['Assembly/MEGAHIT/*.contigs.fa.gz']
            )
            def spades_contigs = getAllFilesFromDir(
                params.outdir, include: ['Assembly/SPAdes/*.fasta.gz']
            )

            // Output dir: GenomeBinning
            def stable_name_binning = getAllFilesFromDir(
                params.outdir,
                include: ['GenomeBinning/**'],
                ignore: ['GenomeBinning/QC/BUSCO/**/{logs,prodigal_output,busco_sequences,hmmer_output}/**'],
                relative: true,
                includeDir: false
            )
            def stable_path_binning = getAllFilesFromDir(
                params.outdir, include: ['GenomeBinning/**'], ignoreFile: 'tests/.nftignore'
            )
            def maxbin2_bins = getAllFilesFromDir(
                params.outdir, include: ['GenomeBinning/MaxBin2/bins/*.fa.gz']
            )
            def maxbin2_unbins = getAllFilesFromDir(
                params.outdir, include: ['GenomeBinning/MaxBin2/{discarded,unbinned/*}/*.fa.gz']
            )
            def metabat2_bins = getAllFilesFromDir(
                params.outdir, include: ['GenomeBinning/MetaBAT2/bins/*.fa.gz']
            )
            def metabat2_unbins = getAllFilesFromDir(
                params.outdir, include: ['GenomeBinning/MetaBAT2/{discarded,unbinned/*}/*.fa.gz']
            )
            def semibin2_bins = getAllFilesFromDir(
                params.outdir, include: ['GenomeBinning/SemiBin2/bins/*.fa.gz']
            )
            def semibin2_logs = getAllFilesFromDir(
                params.outdir, include: ['GenomeBinning/SemiBin2/log/*.log']
            )
            def busco_logs = getAllFilesFromDir(
                params.outdir, include: ['GenomeBinning/QC/BUSCO/*/*-busco.log']
            )
            def binning_quast_logs = getAllFilesFromDir(
                params.outdir, include: ['GenomeBinning/QC/QUAST/*/quast.log']
            )
            def bin_summary = path("${params.outdir}/GenomeBinning/bin_summary.tsv")
            def busco_summary = path("${params.outdir}/GenomeBinning/QC/busco_summary.tsv")
            def quast_bin_summary = path("${params.outdir}/GenomeBinning/QC/quast_bin_summary.tsv")

            // Output dir: Annotation
            def stable_name_annotation = getAllFilesFromDir(
                params.outdir,
                include: ['Annotation/**'],
                ignore: ['Annotation/Prokka/**/*.tmp.*'],
                relative: true,
                includeDir: false
            )
            def stable_path_annotation = getAllFilesFromDir(
                params.outdir, include: ['Annotation/**'], ignoreFile: 'tests/.nftignore'
            )
            def prokka_logs = getAllFilesFromDir(
                params.outdir, include: ['Annotation/Prokka/**/*.log']
            )
            def prokka_gbk = getAllFilesFromDir(
                params.outdir, include: ['Annotation/Prokka/**/*.gbk']
            )
            def prokka_sqn = getAllFilesFromDir(
                params.outdir, include: ['Annotation/Prokka/**/*.sqn']
            )
            def prokka_tsv = getAllFilesFromDir(
                params.outdir, include: ['Annotation/Prokka/**/*.tsv']
            )

            // Output dir: Taxonomy
            def stable_name_taxonomy = getAllFilesFromDir(
                params.outdir, include: ['Taxonomy/**'], relative: true, includeDir: false
            )
            def stable_path_taxonomy = getAllFilesFromDir(
                params.outdir, include: ['Taxonomy/**'], ignoreFile: 'tests/.nftignore'
            )
            def bat_summary = path("${params.outdir}/Taxonomy/CAT/bat_summary.tsv")
            def gtdbtk_summary = path("${params.outdir}/Taxonomy/GTDB-Tk/gtdbtk_summary.tsv")

            // Output directory: multiqc
            def stable_name_multiqc = getAllFilesFromDir(
                params.outdir, include: ['multiqc/**'], relative: true, includeDir: false
            )
            def stable_path_multiqc = getAllFilesFromDir(
                params.outdir, include: ['multiqc/**'], ignoreFile: 'tests/.nftignore'
            )

            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    removeNextflowVersion("${params.outdir}/pipeline_info/nf_core_mag_software_mqc_versions.yml"),
                ).match() },
                { assert snapshot(stable_name_qc,         stable_path_qc        ).match('qc') },
                { assert snapshot(stable_name_assembly,   stable_path_assembly  ).match('assembly') },
                { assert snapshot(stable_name_binning,    stable_path_binning   ).match('binning') },
                { assert snapshot(stable_name_annotation, stable_path_annotation).match('annotation') },
                { assert snapshot(stable_name_taxonomy,   stable_path_taxonomy  ).match('taxonomy') },
                { assert snapshot(stable_name_multiqc,    stable_path_multiqc   ).match('multiqc') },

                { assert snapshot(
                    // FASTA content checks
                    "MEGAHIT contigs non-empty: ${megahit_contigs.every { f -> path("${f}").fasta.size() > 0 }}",
                    "SPAdes contigs non-empty: ${spades_contigs.every { f -> path("${f}").fasta.size() > 0 }}",
                    "MaxBin2 bins non-empty: ${maxbin2_bins.every { f -> path("${f}").fasta.size() > 0 }}",
                    "MaxBin2 unbinned/discarded non-empty: ${maxbin2_unbins.every { f -> path("${f}").fasta.size() >= 0 }}",
                    "MetaBAT2 bins non-empty: ${metabat2_bins.every { f -> path("${f}").fasta.size() > 0 }}",
                    "MetaBAT2 unbinned/discarded non-empty: ${metabat2_unbins.every { f -> path("${f}").fasta.size() >= 0 }}",
                    "SemiBin2 bins non-empty: ${semibin2_bins.every { f -> path("${f}").fasta.size() > 0 }}",
                    // Prokka annotation file checks
                    "Prokka GBK files contain LOCUS: ${prokka_gbk.every { f -> path("${f}").text.contains('LOCUS') }}",
                    "Prokka SQN files non-empty: ${prokka_sqn.every { f -> path("${f}").size() > 0 }}",
                    "Prokka TSV row counts: ${prokka_tsv.collect { f -> "${f.name}=${path("${f}").csv(sep: '\t').rowCount}" }.sort()}",
                    // Summary row count checks
                    "Bin summary non-empty: ${bin_summary.csv(sep: '\t').rowCount > 0}",
                    "Bin summary row count matches bins: ${bin_summary.csv(sep: '\t').rowCount == maxbin2_bins.size() + metabat2_bins.size() + semibin2_bins.size()}",
                    "BUSCO summary non-empty: ${busco_summary.csv(sep: '\t').rowCount > 0}",
                    "QUAST bin summary non-empty: ${quast_bin_summary.csv(sep: '\t').rowCount > 0}",
                    "BAT summary non-empty: ${bat_summary.text.readLines().size() > 1}",
                    "GTDB-Tk summary non-empty: ${gtdbtk_summary.csv(sep: '\t').rowCount > 0}",
                ).match("content-checks") },

                { assert snapshot(
                    "bin_summary.tsv rows: ${bin_summary.csv(sep: '\t').rowCount}",
                    "busco_summary.tsv rows: ${busco_summary.csv(sep: '\t').rowCount}",
                    "quast_bin_summary.tsv rows: ${quast_bin_summary.csv(sep: '\t').rowCount}",
                    "bat_summary.tsv rows: ${bat_summary.text.readLines().size() - 1}",
                    "gtdbtk_summary.tsv rows: ${gtdbtk_summary.csv(sep: '\t').rowCount}",
                ).match("summary-rows") },

                { assert snapshot(
                    "remove_phix_logs match 'overall alignment rate': ${remove_phix_logs.every { log -> log.readLines().last() ==~ /[0-9.]+% overall alignment rate/ }}",
                    "megahit_logs match 'ALL DONE. Time elapsed': ${megahit_logs.every { log -> (log.readLines().last() =~ /ALL DONE. Time elapsed: [0-9.]+ seconds/).find() }}",
                    "spades_logs contains 'SPAdes pipeline finished.': ${spades_logs.every { log -> log.readLines().any { it.contains('SPAdes pipeline finished.') } }}",
                    "assembly_quast_logs contains 'Finished:': ${assembly_quast_logs.every { log -> log.readLines().any { it.contains('Finished:') } }}",
                    "bowtie2_assembly_logs contains 'overall alignment rate': ${bowtie2_assembly_logs.every { log -> log.readLines().any { it.contains('overall alignment rate') } }}",
                    "binning_quast_logs contains 'Finished:': ${binning_quast_logs.every { log -> log.readLines().any { it.contains('Finished:') } }}",
                    "busco_logs contains 'BUSCO analysis done': ${busco_logs.every { log -> log.readLines().any { it.contains('BUSCO analysis done') } }}",
                    "semibin2_logs contains 'Binning finished': ${semibin2_logs.every { log -> log.readLines().any { it.contains('Binning finished') } }}",
                    "prokka_logs contains 'Annotation finished successfully.': ${prokka_logs.every { log -> log.readLines().any { it.contains('Annotation finished successfully.') } }}",
                ).match("log-checks") },
            )
        }
    }
}
