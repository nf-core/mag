{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/mag/main/assets/schema_bins_input.json",
    "title": "nf-core/mag pipeline - params.bins_input schema",
    "description": "Schema for the file provided with params.bins_input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "group": {
                "type": ["string", "integer"],
                "pattern": "^\\S+$",
                "default": "bins",
                "meta": ["id"],
                "errorMessage": "Group must not contain whitespace"
            },
            "fasta": {
                "type": "string",
                "format": "file-path",
                "pattern": "^\\S+\\.fa(\\.gz)?$",
                "exists": true,
                "errorMessage": "Bin FASTA files must exist and have the extension '.fa' or '.fa.gz'"
            }
        },
        "required": ["fasta"]
    },
    "allOf": [{ "uniqueEntries": ["fasta"] }]
}
