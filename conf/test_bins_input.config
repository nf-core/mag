/*
========================================================================================
    Nextflow config file for running minimal tests
========================================================================================
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/mag -profile test_bins_input,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

// Limit resources so that this can run on GitHub Actions
process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h',
    ]

    // Galah and GTDB-Tk results vary with thread count
    withName: 'GALAH|GTDBTK_CLASSIFYWF' {
        cpus = 1
    }
}

params {
    config_profile_name           = 'Test bins input profile'
    config_profile_description    = 'Minimal test dataset to check starting from pre-computed bins'

    bins_input                    = params.pipelines_testdata_base_path + 'mag/samplesheets/bins_samplesheet.csv'

    run_busco                     = false
    run_checkm2                   = true
    checkm2_db                    = params.pipelines_testdata_base_path + 'modules/data/delete_me/binette_checkm2/binette_checkm2_small_db.dmnd'
    skip_quast                    = true

    gtdb_db                       = params.pipelines_testdata_base_path + 'mag/databases/gtdbtk/gtdbtk_mockup_r232_20260507.tar.gz'
    gtdbtk_min_completeness       = 0.01
    gtdbtk_place_species          = true
    gtdbtk_use_full_tree          = true
    gtdbtk_single_job             = true

    // The test CheckM2 database gives meaningless estimates, so accept everything
    dereplicate                   = true
    dereplicate_min_completeness  = 1
    dereplicate_max_contamination = 100
    dereplicate_ani               = 90
}

singularity.pullTimeout = 30.m
