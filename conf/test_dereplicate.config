/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running dereplication tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test
    with --dereplicate on, using the same dataset as the default test profile.

    On this dataset every bin fails the default --dereplicate_min_completeness, so this
    exercises DEREPLICATION's zero-qualifying-genomes fallback path (Galah skipped, every
    bin passed through unclustered) rather than real Galah clustering -- that path is
    covered separately by subworkflows/local/dereplication/tests/main.nf.test. The point
    here is CI coverage of the full pipeline wiring: GTDB-Tk/CAT-BAT/Prokka routing,
    BIN_SUMMARY, MULTIQC.

    Use as follows:
        nextflow run nf-core/mag -profile test_dereplicate,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h',
    ]
}

params {
    config_profile_name         = 'Test dereplicate profile'
    config_profile_description  = 'Minimal test dataset to check pipeline function with --dereplicate'

    // Input data
    input                       = params.pipelines_testdata_base_path + 'mag/samplesheets/samplesheet.multirun.v4.csv'
    min_length_unbinned_contigs = 1
    max_unbinned_contigs        = 2
    skip_ale                    = true
    skip_concoct                = true
    skip_comebin                = true
    skip_metabinner             = true
    busco_db                    = params.pipelines_testdata_base_path + 'mag/databases/busco/bacteria_odb10.2024-01-08.tar.gz'
    busco_db_lineage            = 'bacteria_odb10'
    busco_clean                 = true
    prokka_fast_mode            = true
    gtdb_db                     = params.pipelines_testdata_base_path + 'mag/databases/gtdbtk/gtdbtk_mockup_r232_20260507.tar.gz'
    cat_db                      = params.pipelines_testdata_base_path + 'mag/databases/cat/minigut_cat.tar.gz'
    cat_classify_unbinned       = true
    cat_no_suggestive_asterisks = true
    gtdbtk_min_completeness     = 0.01
    gtdbtk_place_species        = true
    gtdbtk_use_full_tree        = true
    megahit_fix_cpu_1           = true
    spades_fix_cpus             = 1

    run_checkm2                 = true
    dereplicate                 = true
}

process {
    withName: PROKKA {
        ext.args = '--metagenome --fast'
    }
}

singularity.pullTimeout = 30.m
