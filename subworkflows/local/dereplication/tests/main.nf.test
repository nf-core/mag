nextflow_workflow {

    name "Test Subworkflow DEREPLICATION"
    script "../main.nf"
    workflow "DEREPLICATION"

    tag "subworkflows"
    tag "subworkflows_"
    tag "subworkflows/dereplication"
    tag "galah"
    tag "gawk"

    // The two real genomes below are the same pair used by the upstream
    // nf-core/modules galah test; at Galah's default 95% ANI they do NOT
    // cluster together, so this test does not exercise an actual multi-member
    // cluster collapse. What it does verify: each representative genome is
    // correctly rejoined to its own original per-sample metadata (not, say,
    // the other sample's), that eukaryotic bins never reach Galah at all,
    // that the real CheckM2 report format (bare bin stem, no extension, as
    // CheckM2 actually emits it -- confirmed the hard way against a real
    // pipeline run, not just assumed) is correctly matched up by GAWK before
    // reaching Galah (which looks entries up by the bin's original extension
    // with any .gz compression suffix stripped), and that leftover
    // unbinned-contig pseudo-bins (meta.refinement ending in "unbinned")
    // never reach Galah either -- also confirmed against a real run, where
    // CheckM2 didn't reliably produce QC for them and Galah panicked
    // outright on the mismatch rather than warning. sample4 below has no
    // corresponding CheckM2 report row at all, deliberately: if the
    // unbinned exclusion regresses, Galah would panic on it exactly like
    // the real bug, not just silently do the wrong thing.
    test("two prokaryotic bins, one eukaryotic and one unbinned-pseudo-bin filtered out") {

        when {
            workflow {
                """
                // Bin files are named like the real pipeline's binner output
                // (<assembler>-<binner>-<sample>.fa.gz), not just reused as
                // downloaded, since GAWK's .fa suffix (conf/modules.config)
                // is hardcoded to match that real naming convention.
                def stagingDir = File.createTempDir()

                def binSample1 = new File(stagingDir, 'SPAdes-MetaBAT2-sample1.fa.gz')
                file('https://github.com/nf-core/test-datasets/raw/refs/heads/magmap/testdata/GCA_002688505.1_ASM268850v1_genomic.fna.gz', checkIfExists: true).copyTo(binSample1.toPath())

                def binSample2 = new File(stagingDir, 'SPAdes-MetaBAT2-sample2.fa.gz')
                file('https://github.com/nf-core/test-datasets/raw/refs/heads/magmap/testdata/GCF_004296495.1_ASM429649v1_genomic.fna.gz', checkIfExists: true).copyTo(binSample2.toPath())

                def binSample3 = new File(stagingDir, 'SPAdes-MetaBAT2-sample3.fa.gz')
                file('https://github.com/nf-core/test-datasets/raw/refs/heads/magmap/testdata/GCA_002688505.1_ASM268850v1_genomic.fna.gz', checkIfExists: true).copyTo(binSample3.toPath())

                def binSample4 = new File(stagingDir, 'SPAdes-MetaBAT2-sample4.unbinned.1.fa.gz')
                file('https://github.com/nf-core/test-datasets/raw/refs/heads/magmap/testdata/GCF_004296495.1_ASM429649v1_genomic.fna.gz', checkIfExists: true).copyTo(binSample4.toPath())

                input[0] = Channel.of(
                    [
                        [id: 'sample1', assembler: 'SPAdes', binner: 'MetaBAT2', domain: 'prokarya', refinement: 'unrefined'],
                        [file(binSample1)],
                    ],
                    [
                        [id: 'sample2', assembler: 'SPAdes', binner: 'MetaBAT2', domain: 'prokarya', refinement: 'unrefined'],
                        [file(binSample2)],
                    ],
                    [
                        // never reaches Galah: filtered out by domain before collection
                        [id: 'sample3', assembler: 'SPAdes', binner: 'MetaBAT2', domain: 'eukarya', refinement: 'unrefined'],
                        [file(binSample3)],
                    ],
                    [
                        // never reaches Galah: filtered out as a leftover unbinned-contig
                        // pseudo-bin, not a real curated genome
                        [id: 'sample4', assembler: 'SPAdes', binner: 'MetaBAT2', domain: 'prokarya', refinement: 'unrefined_unbinned'],
                        [file(binSample4)],
                    ],
                )

                // Real CheckM2 quality_report.tsv rows for these two genomes
                // (https://github.com/nf-core/test-datasets/blob/modules/data/delete_me/galah/checkm2_report.tsv),
                // Name column exactly as CheckM2 actually emits it: the bare
                // bin stem, no extension at all. DEREPLICATION's own GAWK
                // step (not this test) is what appends '.fa' to match.
                def checkm2Report = File.createTempFile('checkm2_report', '.tsv')
                checkm2Report.text = "Name\\tCompleteness\\tContamination\\tCompleteness_Model_Used\\tTranslation_Table_Used\\tCoding_Density\\tContig_N50\\tAverage_Gene_Length\\tGenome_Size\\tGC_Content\\tTotal_Coding_Sequences\\tTotal_Contigs\\tMax_Contig_Length\\tAdditional_Notes\\n" +
                    "SPAdes-MetaBAT2-sample1\\t96.38\\t0.18\\tNeural Network (Specific Model)\\t4\\t0.896\\t271175\\t315.7548638132296\\t271175\\t0.15\\t257\\t1\\t271175\\tNone\\n" +
                    "SPAdes-MetaBAT2-sample2\\t74.65\\t0.12\\tNeural Network (Specific Model)\\t11\\t0.931\\t200316\\t315.12626262626264\\t200316\\t0.15\\t198\\t1\\t200316\\tNone\\n"

                // Bare path channel, no meta -- matches BIN_QC.out.checkm2_summary's
                // actual shape (workflows/mag.nf passes it straight through).
                input[1] = Channel.of(file(checkm2Report.path))
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert workflow.out.dereplicated_bins.size() == 2 },
                { assert workflow.out.dereplicated_bins.collect { it[0].id }.sort() == ['sample1', 'sample2'] },
                { assert workflow.out.dereplicated_bins.every { it[0].assembler == 'SPAdes' && it[0].binner == 'MetaBAT2' && it[0].domain == 'prokarya' } },
                { assert workflow.out.cluster_tsv.size() == 1 },
                { assert snapshot(workflow.out).match() },
            )
        }
    }

    // Galah 0.4.2 panics (index out of bounds) rather than erroring cleanly
    // when zero genomes pass its quality thresholds
    // (https://github.com/wwood/galah/issues/75). Confirmed for real against
    // nf-core/mag's own test_minigut CI dataset, where every recovered bin
    // happens to fall below the default 50% completeness threshold. This
    // test reuses the same two real genomes as above, but with completeness
    // values that fail the (default) threshold, to confirm DEREPLICATION
    // works around the crash by skipping Galah gracefully rather than
    // invoking it at all.
    test("all bins below quality threshold: Galah skipped, no crash") {

        when {
            workflow {
                """
                def stagingDir = File.createTempDir()

                def binSample1 = new File(stagingDir, 'SPAdes-MetaBAT2-sample1.fa.gz')
                file('https://github.com/nf-core/test-datasets/raw/refs/heads/magmap/testdata/GCA_002688505.1_ASM268850v1_genomic.fna.gz', checkIfExists: true).copyTo(binSample1.toPath())

                def binSample2 = new File(stagingDir, 'SPAdes-MetaBAT2-sample2.fa.gz')
                file('https://github.com/nf-core/test-datasets/raw/refs/heads/magmap/testdata/GCF_004296495.1_ASM429649v1_genomic.fna.gz', checkIfExists: true).copyTo(binSample2.toPath())

                input[0] = Channel.of(
                    [
                        [id: 'sample1', assembler: 'SPAdes', binner: 'MetaBAT2', domain: 'prokarya', refinement: 'unrefined'],
                        [file(binSample1)],
                    ],
                    [
                        [id: 'sample2', assembler: 'SPAdes', binner: 'MetaBAT2', domain: 'prokarya', refinement: 'unrefined'],
                        [file(binSample2)],
                    ],
                )

                // Same two real genomes' real CheckM2 rows, but with
                // Completeness dropped well below the default
                // --dereplicate_min_completeness (50): neither qualifies.
                def checkm2Report = File.createTempFile('checkm2_report', '.tsv')
                checkm2Report.text = "Name\\tCompleteness\\tContamination\\tCompleteness_Model_Used\\tTranslation_Table_Used\\tCoding_Density\\tContig_N50\\tAverage_Gene_Length\\tGenome_Size\\tGC_Content\\tTotal_Coding_Sequences\\tTotal_Contigs\\tMax_Contig_Length\\tAdditional_Notes\\n" +
                    "SPAdes-MetaBAT2-sample1\\t9.6\\t0.18\\tNeural Network (Specific Model)\\t4\\t0.896\\t271175\\t315.7548638132296\\t271175\\t0.15\\t257\\t1\\t271175\\tNone\\n" +
                    "SPAdes-MetaBAT2-sample2\\t7.4\\t0.12\\tNeural Network (Specific Model)\\t11\\t0.931\\t200316\\t315.12626262626264\\t200316\\t0.15\\t198\\t1\\t200316\\tNone\\n"

                input[1] = Channel.of(file(checkm2Report.path))
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert workflow.out.dereplicated_bins.size() == 0 },
                { assert workflow.out.cluster_tsv.size() == 0 },
            )
        }
    }
}
